# FakeTheater 環境變數範例
#
# 本機開發不需要這個檔案，全部都有可用的預設值，直接 npm start 就能跑。
# 這份清單是給部署用的：把它複製成 .env（.env 已在 .gitignore 內）
# 或直接填進 Render / Fly 的環境變數設定。

# ── 正式環境必填 ──────────────────────────────────────────────
# 沒設定這兩個時，NODE_ENV=production 的伺服器會拒絕啟動。

# JWT 簽章金鑰。用隨機值，例如：openssl rand -hex 32
# 一旦外流，任何人都能簽出合法的登入 token。
JWT_SECRET=

# 管理員（帳號 admin）的密碼。
# 種子資料裡的預設值 admin123 公開在原始碼與 README 裡，
# 公開網址上不換掉等於後台不設防。
ADMIN_PASSWORD=

# ── 部署環境相關 ──────────────────────────────────────────────

NODE_ENV=production

# 對外網址，含通訊協定、不含結尾斜線，例如 https://faketheater.onrender.com
# 未設定時由 Host 標頭推導，但 Host 是可被偽造的，正式環境請明確設定。
PUBLIC_URL=

# 部署在反向代理（Render、Fly、Nginx…）後方時設為 1，代表信任一層代理的
# X-Forwarded-* 標頭。沒有代理時請留空 —— 開著等於讓任何人偽造來源 IP。
TRUST_PROXY=1

# 伺服器連接埠
PORT=3000

# SQLite 資料檔位置。容器部署請指向持久化磁碟的掛載點。
DB_PATH=/data/faketheater.db

# ── 業務規則（可選，都有預設值）───────────────────────────────

# 選位後保留座位的毫秒數
SEAT_LOCK_TTL_MS=300000

# 金流訂單多久未付款就失效（毫秒）
PAYMENT_ORDER_TTL_MS=900000

# 改成 sandbox 以外的值，就不會掛載模擬金流商的路由
PAYMENT_PROVIDER=sandbox

# 沙盒模式的簽章金鑰未設定時，每次啟動會各自隨機產生——
# 寫在原始碼裡的金鑰等於沒有金鑰，沙盒流程都在同一行程內，隨機化不影響功能。
# 對接真實金流商的測試環境時，用下面兩個變數帶入該環境的金鑰：
# PAYMENT_HASH_KEY=
# PAYMENT_HASH_IV=

# 退票手續費比例，0 表示不收
REFUND_FEE_RATE=0.1

# 開演前幾分鐘停止受理退票
REFUND_CUTOFF_MINUTES=30

# 公開部署時建議設為 false，隱藏「模擬 Google 登入」按鈕。
# 該按鈕會把所有訪客登入到同一個共用展示帳號（含其餘額與票券）。
DEMO_GOOGLE_LOGIN=true
